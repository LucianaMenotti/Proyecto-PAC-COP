DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_DIALECT=
PORT=
NODE_ENV=development
DB_SYNC_ALTER=true
FRONTEND_ORIGIN=http://localhost:5173
AUTH_SECRET=coloca-una-clave-local-de-al-menos-32-caracteres

# URL base del frontend para armar enlaces (ej. recuperación de contraseña).
# Si no está definida se usa FRONTEND_ORIGIN y luego http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Ruta del frontend que muestra el formulario de nueva contraseña
# (el enlace queda: FRONTEND_URL + PASSWORD_RESET_PATH + ?token=...)
PASSWORD_RESET_PATH=/restablecer

# Envío de correos reales (opcional).
# Sin estas variables no se envían correos: el enlace se imprime solo en la
# consola del backend para facilitar el desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
